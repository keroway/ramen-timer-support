{
  "name": "ramen-timer-support",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.28.9",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome ci",
    "format": "biome format --write . && prettier --write \"**/*.{astro,css}\"",
    "format:check": "biome ci && prettier --check \"**/*.{astro,css}\"",
    "a11y": "html-validate \"dist/**/*.html\" && node scripts/check-csp-scripts.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:contrast:test": "node --test scripts/check-contrast.test.mjs",
    "check:csp:test": "node --test scripts/check-csp-scripts.test.mjs",
    "generate:og-image": "npx --yes sharp-cli@5.2.0 -i assets/og-image.svg -o public -f png resize 1200 630"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@biomejs/biome": "2.6.4",
    "html-validate": "11.17.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "wrangler": "4.155.0"
  }
}
