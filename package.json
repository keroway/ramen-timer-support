{
  "name": "ramen-timer-support",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "postinstall": "lefthook install",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome ci",
    "format": "biome format --write . && prettier --write \"**/*.{astro,css}\"",
    "format:check": "biome ci && prettier --check \"**/*.{astro,css}\"",
    "generate:og-image": "npx --yes sharp-cli -i assets/og-image.svg -o public -f png resize 1200 630"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@biomejs/biome": "2.5.5",
    "lefthook": "2.1.10",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3",
    "wrangler": "4.114.0"
  }
}
