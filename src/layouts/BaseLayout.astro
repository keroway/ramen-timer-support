---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: string;
}

const { title, description, ogType = "website" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#fff7e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17110d" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="まてた！ラーメンタイマー" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a href="#main" class="skip-link">本文へスキップ</a>
    <header class="site-header">
      <a href="/">
        <strong>まてた！ラーメンタイマー</strong>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="サイト内リンク" class="site-nav">
        <a href="/" aria-current={currentPath === "/" ? "page" : undefined}>サポート</a>
        <a href="/privacy" aria-current={currentPath === "/privacy" ? "page" : undefined}
          >プライバシーポリシー</a
        >
      </nav>
      <p>&copy; {new Date().getFullYear()} keroway</p>
    </footer>
  </body>
</html>
